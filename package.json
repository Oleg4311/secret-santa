{
  "name": "secret-santa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Тайный Санта в браузере: жеребьёвка с исключениями, персональные ссылки, без регистрации и сервера",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "node --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "e2e": "playwright test",
    "og": "node scripts/make-og.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "deploy:worker": "npm run build:worker && wrangler deploy --config worker/wrangler.jsonc",
    "dev:worker": "npm run build:worker && wrangler dev --config worker/wrangler.jsonc"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.166.0"
  }
}
